{
  "name": "@yami/docsite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "pnpm check:content && next build",
    "start": "next start -p 3400",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:access": "playwright test -c playwright.access.config.ts",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "check:content": "node scripts/check-content.mjs",
    "generate:blog-covers": "node scripts/generate-blog-covers.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@yami/design-system": "workspace:*",
    "@yami/site-access": "workspace:*",
    "gray-matter": "4.0.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.0",
    "playwright-core": "1.64.0",
    "puppeteer-core": "25.13.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
