{
  "name": "@yami/topic-generator",
  "version": "0.3.0",
  "private": true,
  "description": "Portable TOPIC GENERATOR with intent analysis, versioned product selection, Yami catalog adapters, CLI, and Web UI",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": "./web/index.ts"
  },
  "bin": {
    "topic-generator": "./bin/topic-generator.mjs",
    "topic-intent-eval": "./bin/topic-intent-eval.mjs"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "evals",
    "integrations",
    "web",
    "global.d.ts",
    "README.md",
    "product.manifest.json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "analyze": "pnpm run build && node dist/cli.js",
    "evaluate": "pnpm run build && node dist/evaluate-cli.js"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
