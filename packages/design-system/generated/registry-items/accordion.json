      },
      "--focus-ring": {
        "property": "outline-color",
        "selector": ".trigger:focus-visible"
      },
      "--stroke-thick": {
        "property": "outline-width",
        "selector": ".trigger:focus-visible"
      },
      "--space-025": {
        "property": "outline-offset",
        "selector": ".trigger:focus-visible"
      },
      "--space-050": {
        "property": "padding-block",
        "selector": ".root"
      },
      "--font-weight-normal": {
        "property": "font-weight",
        "selector": ".content"
      },
      "--font-size-body-md": {
        "property": "font-size",
        "selector": ".content"
      },
      "--line-height-body-md": {
        "property": "line-height",
        "selector": ".content"
      }
