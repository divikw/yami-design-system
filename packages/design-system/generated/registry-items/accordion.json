      },
      "--space-200": {
        "property": "width / height",
        "selector": ".icon"
      },
      "--button-tertiary-active": {
        "property": "background",
        "selector": ".trigger:active:not(:disabled)"
      },
      "--button-disabled": {
        "property": "background",
