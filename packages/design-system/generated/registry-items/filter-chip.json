      },
      "--border-focus": {
        "property": "inset box-shadow",
        "selector": ".filled[aria-pressed='true'], .outlined[aria-pressed='true']"
      },
      "--color-black-200": {
        "property": "background-color",
        "selector": ".categoryToggle:hover"
      },
      "--radius-full": {
        "property": "border-radius",
        "selector": ".chip"
      }
    }
  },
  "quality": {
