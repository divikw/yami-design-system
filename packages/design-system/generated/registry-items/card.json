  "design": {
    "tokens": [
      "--border-default",
      "--border-default-inverse",
      "--border-focus",
      "--radius-surface-default",
      "--space-150",
      "--space-200",
      "--space-300",
      "--surface-inverse",
      "--surface-primary",
      "--surface-secondary",
      "--text-disabled",
      "--text-disabled-inverse",
      "--text-primary",
      "--text-primary-inverse"
    ],
    "rules": [
      "card-no-border",
      "elevation-on-press",
      "focus-style",
      "no-custom-radii"
    ],
    "tokenBindings": {
      "--surface-primary": {
        "property": "background-color",
        "selector": ".card, .surface-primary"
      },
      "--surface-secondary": {
        "property": "background-color",
        "selector": ".surface-secondary"
      },
      "--surface-inverse": {
        "property": "background-color",
        "selector": ".surface-inverse"
      },
      "--text-primary": {
        "property": "color / background-color",
        "selector": ".card, .interactive:hover, .interactive:active"
      },
      "--text-primary-inverse": {
        "property": "color",
        "selector": ".surface-inverse"
      },
      "--text-disabled": {
        "property": "color",
        "selector": ".card:is(:disabled, [aria-disabled='true'])"
      },
      "--text-disabled-inverse": {
        "property": "color",
        "selector": ".card.surface-inverse:is(:disabled, [aria-disabled='true'])"
      },
      "--border-default": {
        "property": "border-color",
        "selector": ".bordered"
      },
      "--border-default-inverse": {
        "property": "border-color",
        "selector": ".bordered.surface-inverse"
      },
      "--border-focus": {
        "property": "outline-color",
        "selector": ".card:focus-visible"
      },
      "--radius-surface-default": {
        "property": "border-radius",
        "selector": ".card"
      },
      "--space-150": {
        "property": "padding",
        "selector": ".pad-sm"
      },
      "--space-200": {
        "property": "padding",
        "selector": ".pad-md"
      },
      "--space-300": {
        "property": "padding",
        "selector": ".pad-lg"
      }
    }
  },
  "quality": {
    "accessibility": {
      "role": "none (div); native button or link when as selects those hosts",
      "wcagLevel": "AA",
      "tapTargetMin": 44,
      "keyboardNav": [
        "tab",
        "enter",
        "space"
      ],
      "ariaPattern": "none (default) | native button | native link",
      "notes": "The 44px minimum applies only with interactive styling. Static divs have no implicit group role or tab stop. Buttons support Enter/Space and native disabled; links support Enter. Custom hosts own semantics and activation, including aria-disabled behavior. Focusable hosts retain a theme-aware focus outline even when interactive=false; disabled text and cursor styling also remain available."
    },
    "interactionCoverage": "covered"
  },
