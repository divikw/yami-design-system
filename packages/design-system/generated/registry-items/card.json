{
  "$schema": "../../schema/registry-item.json",
  "schemaVersion": 2,
  "name": "card",
  "title": "Card",
  "type": "component",
  "status": "stable",
  "version": "0.1.0",
  "description": "Surface for a self-contained item with optional header, title, description, action, content and footer. Default padding: 16px on every device; 12px surface radius, no border or shadow. Native link/button hosts support single interactions; keep mixed actions inside a static Card. Child overflow remains visible; crop media separately.",
  "source": "components/Card",
  "files": [
    {
      "source": "components/Card/Card.module.css",
      "target": "components/Card/Card.module.css"
    },
    {
      "source": "components/Card/Card.tsx",
      "target": "components/Card/Card.tsx"
    },
    {
      "source": "components/Card/index.ts",
      "target": "components/Card/index.ts"
    }
  ],
  "exports": [
    "Card",
    "CardAction",
    "CardContent",
    "CardDescription",
    "CardFooter",
    "CardHeader",
    "CardPadding",
    "CardProps",
    "CardSurface",
    "CardTitle"
  ],
  "composes": [],
  "dependencies": {
    "runtime": [
      "react",
      "@base-ui/react"
    ],
    "peer": [],
    "devOnly": []
  },
  "documentation": {
    "usage": "components/Card/usage.md",
    "stories": [
      "components/Card/Card.stories.tsx"
    ],
    "examples": [
      "components/Card/examples.tsx#BasicCard",
      "components/Card/examples.tsx#NoPaddingCard",
      "components/Card/examples.tsx#BorderedCard",
      "components/Card/examples.tsx#LinkCard",
      "components/Card/examples.tsx#ButtonCard",
      "components/Card/examples.tsx#DisabledButtonCard",
      "components/Card/examples.tsx#InverseLinkCard",
      "components/Card/examples.tsx#SurfaceSecondaryCard",
      "components/Card/examples.tsx#SurfaceInverseCard"
    ]
  },
  "design": {
    "tokens": [
      "--border-default",
      "--border-default-inverse",
      "--focus-ring",
      "--font-size-heading-sm",
      "--font-weight-emphasize",
      "--line-height-heading-sm",
      "--radius-surface-default",
      "--space-0",
      "--space-050",
      "--space-100",
      "--space-200",
      "--space-300",
      "--space-400",
      "--surface-inverse",
      "--surface-primary",
      "--surface-secondary",
      "--text-disabled",
      "--text-disabled-inverse",
      "--text-primary",
      "--text-primary-inverse",
      "--text-secondary",
      "--text-secondary-inverse"
    ],
    "rules": [
      "card-no-border",
      "elevation-on-press",
      "focus-style",
      "no-custom-radii"
    ],
    "tokenBindings": {
      "--font-size-heading-sm": {
        "property": "font-size",
        "selector": ".title"
      },
      "--line-height-heading-sm": {
        "property": "line-height",
        "selector": ".title"
      },
      "--font-weight-emphasize": {
        "property": "font-weight",
        "selector": ".title"
      },
      "--text-secondary": {
        "property": "color",
        "selector": ".description"
      },
      "--text-secondary-inverse": {
        "property": "color",
        "selector": ".surface-inverse > .content > .header > .description"
      },
      "--surface-primary": {
        "property": "background-color",
        "selector": ".card, .surface-primary"
      },
      "--surface-secondary": {
        "property": "background-color",
        "selector": ".surface-secondary"
      },
      "--surface-inverse": {
        "property": "background-color",
        "selector": ".surface-inverse"
      },
      "--text-primary": {
        "property": "color / background-color",
        "selector": ".card, .interactive:hover, .interactive:active"
      },
      "--text-primary-inverse": {
        "property": "color",
        "selector": ".surface-inverse"
      },
      "--text-disabled": {
        "property": "color",
        "selector": ".card:is(:disabled, [aria-disabled='true'])"
      },
      "--text-disabled-inverse": {
        "property": "color",
        "selector": ".card.surface-inverse:is(:disabled, [aria-disabled='true'])"
      },
      "--border-default": {
        "property": "border-color",
        "selector": ".bordered"
      },
      "--border-default-inverse": {
        "property": "border-color",
        "selector": ".bordered.surface-inverse"
      },
      "--focus-ring": {
        "property": "outline-color",
        "selector": ".card:focus-visible"
      },
      "--radius-surface-default": {
        "property": "border-radius",
        "selector": ".card"
      },
      "--space-200": {
        "property": "--card-spacing (padding and section gap)",
        "selector": ".pad-md"
      },
      "--space-400": {
        "property": "min-width / min-height",
        "selector": ".interactive"
      },
      "--space-100": {
        "property": "--card-spacing (padding and section gap)",
        "selector": ".pad-sm"
      },
      "--space-0": {
        "property": "--card-spacing (padding and section gap)",
        "selector": ".pad-none"
      },
      "--space-300": {
        "property": "--card-spacing (padding and section gap)",
        "selector": ".pad-lg"
      },
      "--space-050": {
        "property": "margin-block-end",
        "selector": ".content > :is(h1, h2, h3, h4, h5, h6):has(+ p)"
      }
    }
  },
  "quality": {
    "accessibility": {
      "role": "none (div); native button or link when as selects those hosts",
      "wcagLevel": "AA",
      "tapTargetMin": 32,
      "keyboardNav": [
        "tab",
        "enter",
        "space"
      ],
      "ariaPattern": "none (default) | native button | native link",
      "notes": "The 32px minimum applies only with interactive styling. Static divs have no implicit group role or tab stop. Buttons support Enter/Space and native disabled; links support Enter. Custom hosts own semantics and activation, including aria-disabled behavior. Focusable hosts retain a theme-aware focus outline even when interactive=false; disabled text and cursor styling also remain available."
    },
    "interactionCoverage": "covered"
  },
  "contentDigest": "61db5c751714ce29c13bed88759f6395f810db52b4f001ce8b34330954950022"
}
