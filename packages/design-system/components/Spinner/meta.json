{
  "$schema": "../../schema/component.json",
  "name": "Spinner",
  "category": "display",
  "status": "experimental",
  "version": "0.1.0",
  "description": "An indeterminate loading indicator that inherits its size and color.",
  "figma": {
    "nodeId": null,
    "componentKey": null
  },
  "exports": [
    "SpinnerProps",
    "Spinner"
  ],
  "props": {
    "aria-label": {
      "type": "string",
      "required": false
    },
    "aria-labelledby": {
      "type": "string",
      "required": false
    },
    "style": {
      "type": "CSSProperties",
      "required": false
    }
  },
  "rules": {
    "tokens": {
      "ruleId": "token-exists"
    }
  },
  "tokens": [
    "--stroke-thick",
    "--radius-full"
  ],
  "tokenBindings": {
    "--stroke-thick": {
      "property": "border",
      "selector": ".root"
    },
    "--radius-full": {
      "property": "border-radius",
      "selector": ".root"
    }
  },
  "accessibility": {
    "role": "status when named",
    "notes": "A named spinner exposes a status. Unnamed spinners are decorative beside an existing status or busy button."
  },
  "testing": {
    "interaction": "not-applicable",
    "rationale": "Read-only status indicator with no user interaction."
  },
  "dependencies": {
    "runtime": [
      "react"
    ],
    "peer": [],
    "devOnly": [
      "@storybook/react-vite",
      "storybook"
    ]
  },
  "usageRef": "./usage.md",
  "examples": [
    "./examples.tsx#LoadingOrders"
  ]
}
