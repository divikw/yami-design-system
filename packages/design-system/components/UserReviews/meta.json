{
  "$schema": "../../schema/component.json",
  "name": "UserReviews",
  "category": "composite",
  "status": "experimental",
  "version": "0.1.0",
  "description": "Homepage app download links and a responsive panel of curated user reviews.",
  "figma": {
    "fileKey": "MHQHWiNXDr06jybKwJNVvs",
    "nodeId": "792:104395",
    "componentKey": null,
    "notes": "Desktop source section. Mobile uses an optional app icon and a single download button."
  },
  "exports": ["UserReviews", "UserReviewsProps", "UserReview"],
  "composes": ["Button", "Card", "Divider", "SectionHeading"],
  "props": {
    "download": {
      "type": "UserReviewsProps['download']",
      "required": true,
      "description": "Store URLs and icon sources, the QR image and its equivalent link, and an optional mobile download URL and app icon."
    },
    "reviewColumns": {
      "type": "readonly (readonly UserReview[])[]",
      "required": true,
      "description": "Ordered review groups. Each review has a unique id, quote, and author."
    },
    "locale": {
      "type": "\"zh\" | \"en\"",
      "required": false,
      "default": "zh",
      "description": "Language for the built-in copy. Review text and assets are supplied by the caller."
    },
    "titleStyle": {
      "type": "\"display\" | \"section\"",
      "required": false,
      "default": "display",
      "description": "Use the standalone display scale or the shared section heading scale."
    },
    "titleFontFamily": {
      "type": "\"sans\" | \"serif\"",
      "required": false,
      "default": "sans",
      "description": "Font family for the download title."
    },
    "dividerPosition": {
      "type": "\"top\" | \"bottom\" | \"none\"",
      "required": false,
      "default": "top",
      "description": "Edge of the outer section that draws a divider."
    },
    "dividerVariant": {
      "type": "\"gray\" | \"black\"",
      "required": false,
      "default": "gray",
      "description": "Gray draws the 1px structural divider. Black draws the 2px emphasis divider."
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Additional class on the outer section for page composition."
    }
  },
  "rules": {
    "shape": { "ruleId": "no-custom-radii" },
    "focus": { "ruleId": "focus-style" },
    "targets": { "ruleId": "tap-target" }
  },
  "tokens": [
    "--border-default",
    "--divider-emphasis",
    "--fill-inverse",
    "--fill-primary",
    "--focus-ring",
    "--font-family-ios",
    "--font-family-serif",
    "--font-size-body-md",
    "--font-size-body-xl",
    "--font-size-display-md",
    "--font-size-display-sm",
    "--font-size-heading-xl",
    "--font-weight-emphasize",
    "--font-weight-semibold",
    "--line-height-body-md",
    "--line-height-body-xl",
    "--line-height-display-md",
    "--line-height-display-sm",
    "--line-height-heading-xl",
    "--radius-component-default",
    "--radius-surface-default",
    "--radius-surface-sheet",
    "--radius-tag-primary",
    "--space-025",
    "--space-050",
    "--space-100",
    "--space-150",
    "--space-200",
    "--space-300",
    "--space-400",
    "--space-600",
    "--stroke-default",
    "--stroke-thick",
    "--surface-primary",
    "--surface-secondary",
    "--text-primary",
    "--text-secondary"
  ],
  "tokenBindings": {
    "--surface-secondary": { "property": "background", "selector": ".panel" },
    "--surface-primary": { "property": "background", "selector": ".reviewCard::before" },
    "--radius-surface-default": { "property": "border-radius", "selector": ".panel" },
    "--radius-surface-sheet": { "property": "border-radius", "selector": ".reviewGrid .reviewCard" },
    "--radius-component-default": { "property": "border-radius", "selector": ".qrLink" }
  },
  "accessibility": {
    "structure": "Named section with a heading, native download links, and a static review region with lists and block quotes.",
    "tapTargetMin": 24,
    "keyboardNav": ["Tab", "Enter"]
  },
  "dependencies": {
    "runtime": ["react", "./Button", "./Card", "./Divider", "./SectionHeading"],
    "peer": [],
    "devOnly": []
  },
  "usageRef": "./usage.md",
  "examples": ["./examples.tsx#UserReviewsExample"],
  "testing": {
    "interaction": "covered",
    "rationale": "The Showcase checks all three link destinations and the download links' keyboard focus order."
  }
}
