{
  "$schema": "../../schema/component.json",
  "name": "EmptyState",
  "category": "display",
  "status": "experimental",
  "version": "0.1.0",
  "description": "Compose empty states with media, a heading, descriptive text and optional actions.",
  "figma": {
    "nodeId": null,
    "componentKey": null
  },
  "exports": [
    "EmptyStateProps",
    "EmptyState",
    "EmptyStateHeaderProps",
    "EmptyStateHeader",
    "EmptyStateMediaProps",
    "EmptyStateMedia",
    "EmptyStateTitleProps",
    "EmptyStateTitle",
    "EmptyStateDescriptionProps",
    "EmptyStateDescription",
    "EmptyStateContentProps",
    "EmptyStateContent"
  ],
  "props": {
    "children": {
      "type": "ReactNode",
      "required": false
    }
  },
  "rules": {
    "tokens": {
      "ruleId": "token-exists"
    }
  },
  "tokens": [
    "--space-200",
    "--space-300",
    "--radius-surface-default",
    "--text-primary",
    "--font-family-ios",
    "--space-100",
    "--space-500",
    "--radius-component-default",
    "--surface-secondary",
    "--font-size-heading-sm",
    "--line-height-heading-sm",
    "--font-weight-semibold",
    "--font-size-body-md",
    "--line-height-body-md",
    "--text-secondary"
  ],
  "tokenBindings": {
    "--space-200": {
      "property": "gap",
      "selector": ".root"
    },
    "--space-300": {
      "property": "padding",
      "selector": ".root"
    },
    "--radius-surface-default": {
      "property": "border-radius",
      "selector": ".root"
    },
    "--text-primary": {
      "property": "color",
      "selector": ".root"
    },
    "--font-family-ios": {
      "property": "font-family",
      "selector": ".root"
    },
    "--space-100": {
      "property": "gap",
      "selector": ".header, .content"
    },
    "--space-500": {
      "property": "width",
      "selector": ".media[data-variant=\"icon\"]"
    },
    "--radius-component-default": {
      "property": "border-radius",
      "selector": ".media[data-variant=\"icon\"]"
    },
    "--surface-secondary": {
      "property": "background",
      "selector": ".media[data-variant=\"icon\"]"
    },
    "--font-size-heading-sm": {
      "property": "font-size",
      "selector": ".root .title"
    },
    "--line-height-heading-sm": {
      "property": "line-height",
      "selector": ".root .title"
    },
    "--font-weight-semibold": {
      "property": "font-weight",
      "selector": ".root .title"
    },
    "--font-size-body-md": {
      "property": "font-size",
      "selector": ".description"
    },
    "--line-height-body-md": {
      "property": "line-height",
      "selector": ".description"
    },
    "--text-secondary": {
      "property": "color",
      "selector": ".description"
    }
  },
  "accessibility": {
    "role": "none",
    "notes": "The title is an h2. Controls provided by the host retain their native semantics."
  },
  "testing": {
    "interaction": "covered",
    "rationale": "Showcase invokes the host action by its accessible name."
  },
  "dependencies": {
    "runtime": [
      "react"
    ],
    "peer": [],
    "devOnly": [
      "@storybook/react-vite",
      "storybook"
    ]
  },
  "usageRef": "./usage.md",
  "examples": [
    "./examples.tsx#SavedLists"
  ]
}
