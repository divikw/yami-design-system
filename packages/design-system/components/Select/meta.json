{
  "$schema": "../../schema/component.json",
  "name": "Select",
  "category": "form",
  "status": "experimental",
  "version": "0.1.0",
  "description": "YAMI single-value select. Compose SelectTrigger, SelectValue, SelectContent and SelectItem for keyboard navigation, disabled options and native forms.",
  "figma": {
    "nodeId": null,
    "componentKey": null,
    "notes": "Adapted from maintained YAMI page/component styles. No independently verified Figma binding."
  },
  "exports": [
    "Select",
    "SelectProps",
    "SelectTrigger",
    "SelectTriggerProps",
    "SelectContent",
    "SelectContentProps",
    "SelectItem",
    "SelectItemProps",
    "SelectValue",
    "SelectLabel",
    "SelectList",
    "SelectGroup",
    "SelectGroupLabel",
    "SelectSeparator"
  ],
  "composes": ["Field"],
  "props": {
    "density": {
      "type": "default | compact",
      "required": false,
      "description": "Default is 56px with an embedded label; compact is 40px with an external label on PC and Mobile."
    },
    "label": {
      "type": "ReactNode",
      "required": false,
      "description": "Visible label. Its position follows the density."
    },
    "value": {
      "type": "string | null",
      "required": false,
      "description": "Controlled selected value; null means no selection."
    },
    "defaultValue": {
      "type": "string",
      "required": false,
      "description": "Initially selected value in uncontrolled mode."
    },
    "onValueChange": {
      "type": "function",
      "required": false,
      "description": "Called when the selected value changes."
    },
    "items": {
      "type": "array",
      "required": false,
      "description": "Option data for labels and typeahead while closed."
    },
    "disabled": {
      "type": "boolean",
      "required": false,
      "description": "Disables the entire select."
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "Native form field name."
    },
    "required": {
      "type": "boolean",
      "required": false,
      "description": "Enables native required validation."
    }
  },
  "variants": {
    "density": ["default", "compact"],
    "state": [
      "default",
      "focus-visible",
      "invalid",
      "disabled"
    ]
  },
  "rules": {
    "focus": {
      "ruleId": "focus-style",
      "note": "Keyboard controls use semantic focus-ring outlines."
    },
    "color": {
      "ruleId": "semantic-color-only",
      "note": "Uses existing semantic surface, text and border tokens."
    }
  },
  "tokens": [
    "--border-default",
    "--fill-tertiary",
    "--color-black-400",
    "--color-white-400",
    "--elevation-400-menu-panel",
    "--focus-ring",
    "--font-family-ios",
    "--font-size-body-md",
    "--line-height-body-md",
    "--radius-component-default",
    "--radius-tag-primary",
    "--border-attention",
    "--text-secondary",
    "--divider-default",
    "--font-size-caption-sm",
    "--space-025",
    "--space-050",
    "--space-100",
    "--space-150",
    "--space-200",
    "--space-250",
    "--space-300",
    "--stroke-default",
    "--stroke-thick",
    "--surface-primary",
    "--surface-secondary",
    "--text-disabled",
    "--text-primary",
    "--space-400",
    "--space-500",
    "--space-600"
  ],
  "tokenBindings": {
    "--fill-tertiary": {
      "property": "background",
      "selector": ".trigger[data-disabled]"
    },
    "--surface-primary": {
      "property": "background",
      "selector": ".trigger, .content"
    },
    "--surface-secondary": {
      "property": "background",
      "selector": ".item[data-highlighted]"
    },
    "--border-default": {
      "property": "border-color",
      "selector": ".trigger, .content"
    },
    "--color-black-400": {
      "property": "color",
      "selector": ".trigger::after, .trigger[data-placeholder]:not([data-disabled])"
    },
    "--color-white-400": {
      "property": "color",
      "selector": ".dark .trigger::after, .dark .trigger[data-placeholder]:not([data-disabled])"
    },
    "--radius-component-default": {
      "property": "border-radius",
      "selector": ".trigger, .content"
    },
    "--radius-tag-primary": {
      "property": "border-radius",
      "selector": ".item"
    },
    "--elevation-400-menu-panel": {
      "property": "box-shadow",
      "selector": ".content"
    },
    "--focus-ring": {
      "property": "outline-color",
      "selector": ".trigger:focus-visible"
    },
    "--space-200": {
      "property": "mask",
      "selector": ".trigger::after"
    },
    "--space-250": {
      "property": "width",
      "selector": ".trigger::after"
    },
    "--space-300": {
      "property": "padding-inline-end",
      "selector": ".trigger"
    },
    "--space-400": {
      "property": "min-height",
      "selector": ".item"
    },
    "--space-600": {
      "property": "min-height",
      "selector": ".trigger[data-density='default']"
    },
    "--space-500": {
      "property": "min-height",
      "selector": ".trigger"
    }
  },
  "accessibility": {
    "role": "combobox / listbox / option",
    "keyboardNav": [
      "tab",
      "shift+tab",
      "space",
      "enter",
      "escape",
      "arrow-down",
      "arrow-up"
    ],
    "tapTargetMin": 32,
    "notes": "Label the trigger with SelectLabel or aria-label. Arrow keys skip disabled items; Escape closes and restores trigger focus."
  },
  "testing": {
    "interaction": "covered",
    "rationale": "Story play and browser tests verify state, keyboard interaction, forms and popup dismissal."
  },
  "dependencies": {
    "runtime": [
      "react",
      "@base-ui/react"
    ],
    "peer": [],
    "devOnly": [
      "@storybook/react-vite",
      "storybook"
    ]
  },
  "usageRef": "./usage.md",
  "examples": [
    "./examples.tsx#BasicSelect"
  ]
}
