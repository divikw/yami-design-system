{
  "$schema": "../../schema/component.json",
  "name": "Toast",
  "category": "display",
  "status": "experimental",
  "version": "0.1.0",
  "description": "Transient notifications with status icons, actions, stacking and async updates.",
  "figma": {
    "nodeId": null,
    "componentKey": null
  },
  "exports": [
    "createToastManager",
    "useToastManager",
    "toast",
    "ToastProvider",
    "ToastPortal",
    "ToastProps",
    "Toast",
    "ToastViewport",
    "ToastContent",
    "ToastTitle",
    "ToastDescription",
    "ToastAction",
    "ToastClose",
    "ToastPosition",
    "ToasterProps",
    "Toaster"
  ],
  "props": {
    "toast": {
      "type": "ToastObject",
      "required": true
    }
  },
  "rules": {
    "tokens": {
      "ruleId": "token-exists"
    }
  },
  "tokens": [
    "--space-200",
    "--surface-primary",
    "--stroke-default",
    "--border-default",
    "--radius-surface-default",
    "--elevation-400-menu-panel",
    "--text-primary",
    "--font-weight-normal",
    "--font-size-body-md",
    "--line-height-body-md",
    "--font-family-ios",
    "--space-100",
    "--stroke-thick",
    "--focus-ring",
    "--space-150",
    "--font-weight-emphasize",
    "--text-secondary",
    "--space-050",
    "--text-success",
    "--text-info",
    "--text-warning",
    "--text-error"
  ],
  "tokenBindings": {
    "--space-200": {
      "property": "inset-inline",
      "selector": ".viewport"
    },
    "--surface-primary": {
      "property": "background",
      "selector": ".root"
    },
    "--stroke-default": {
      "property": "border",
      "selector": ".root"
    },
    "--border-default": {
      "property": "border",
      "selector": ".root"
    },
    "--radius-surface-default": {
      "property": "border-radius",
      "selector": ".root"
    },
    "--elevation-400-menu-panel": {
      "property": "box-shadow",
      "selector": ".root"
    },
    "--text-primary": {
      "property": "color",
      "selector": ".root"
    },
    "--font-weight-normal": {
      "property": "font",
      "selector": ".root"
    },
    "--font-size-body-md": {
      "property": "font",
      "selector": ".root"
    },
    "--line-height-body-md": {
      "property": "font",
      "selector": ".root"
    },
    "--font-family-ios": {
      "property": "font",
      "selector": ".root"
    },
    "--space-100": {
      "property": "--lift",
      "selector": ".root"
    },
    "--stroke-thick": {
      "property": "outline",
      "selector": ".root:focus-visible"
    },
    "--focus-ring": {
      "property": "outline",
      "selector": ".root:focus-visible"
    },
    "--space-150": {
      "property": "padding",
      "selector": ".content"
    },
    "--font-weight-emphasize": {
      "property": "font-weight",
      "selector": ".title"
    },
    "--text-secondary": {
      "property": "color",
      "selector": ".description"
    },
    "--space-050": {
      "property": "margin-top",
      "selector": ".title + .description"
    },
    "--text-success": {
      "property": "color",
      "selector": ".root[data-type=\"success\"] .icon"
    },
    "--text-info": {
      "property": "color",
      "selector": ".root[data-type=\"info\"] .icon"
    },
    "--text-warning": {
      "property": "color",
      "selector": ".root[data-type=\"warning\"] .icon"
    },
    "--text-error": {
      "property": "color",
      "selector": ".root[data-type=\"error\"] .icon"
    }
  },
  "accessibility": {
    "role": "dialog / alertdialog",
    "notes": "Base UI manages live regions, F6 focus, pause on interaction and dismissal."
  },
  "testing": {
    "interaction": "covered",
    "rationale": "Showcase verifies undo and explicit dismissal."
  },
  "dependencies": {
    "runtime": [
      "react",
      "@base-ui/react"
    ],
    "peer": [],
    "devOnly": [
      "@storybook/react-vite",
      "storybook"
    ]
  },
  "usageRef": "./usage.md",
  "examples": [
    "./examples.tsx#SaveForLater"
  ],
  "composes": [
    "Button",
    "Spinner"
  ]
}
