{
  "$schema": "../../schema/component.json",
  "name": "Divider",
  "category": "layout",
  "status": "stable",
  "version": "0.1.0",

  "description": "Content separator with default (1px) and emphasis (2px) strengths. A separate inverse boolean selects opposite-polarity surface colors in either theme. Horizontal renders as semantic <hr>; vertical renders as decorative <span aria-hidden=\"true\">.",

  "figma": { "nodeId": null, "componentKey": null },

  "exports": ["Divider", "DividerOrientation", "DividerProps", "DividerStrength"],

  "testing": {
    "interaction": "not-applicable",
    "rationale": "Semantic separator with no interactive behavior."
  },

  "variants": {
    "strength": ["default", "emphasis"],
    "inverse": [false, true],
    "orientation": ["horizontal", "vertical"]
  },

  "props": {
    "strength": {
      "type": "enum",
      "values": ["default", "emphasis"],
      "required": false,
      "default": "default",
      "description": "Visual weight. default uses a 1px stroke; emphasis uses a 2px stroke. Colors follow semantic divider tokens."
    },
    "inverse": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Use opposite-polarity surface colors within the active theme without changing thickness."
    },
    "orientation": {
      "type": "enum",
      "values": ["horizontal", "vertical"],
      "required": false,
      "default": "horizontal"
    }
  },

  "rules": {
    "borderStrength": {
      "ruleId": "border-strength",
      "note": "Use semantic divider colors and the two supported stroke weights. Pick default for ordinary structure; emphasis for major section boundaries."
    }
  },

  "tokens": [
    "--divider-default",
    "--divider-default-inverse",
    "--divider-emphasis",
    "--divider-emphasis-inverse",
    "--stroke-default",
    "--stroke-thick"
  ],

  "tokenBindings": {
    "--divider-default": {
      "property": "background-color",
      "selector": ".default"
    },
    "--divider-default-inverse": {
      "property": "background-color",
      "selector": ".default.inverse"
    },
    "--divider-emphasis": {
      "property": "background-color",
      "selector": ".emphasis"
    },
    "--divider-emphasis-inverse": {
      "property": "background-color",
      "selector": ".emphasis.inverse"
    },
    "--stroke-default": {
      "property": "height / width",
      "selector": ".horizontal, .vertical"
    },
    "--stroke-thick": {
      "property": "height / width",
      "selector": ".horizontal.emphasis, .vertical.emphasis"
    }
  },

  "accessibility": {
    "role": "separator (horizontal); none (vertical)",
    "wcagLevel": "AA",
    "tapTargetMin": 0,
    "keyboardNav": [],
    "ariaPattern": "native separator (horizontal); aria-hidden=true (vertical)",
    "notes": "Non-interactive. Horizontal <hr> exposes native separator semantics and accepts aria-label. Vertical <span> is decorative and hidden from assistive technology; the parent provides content grouping semantics."
  },

  "dependencies": {
    "runtime": ["react"],
    "peer": [],
    "devOnly": []
  },

  "usageRef": "./usage.md",
  "examples": [
    "./examples.tsx#DefaultDivider",
    "./examples.tsx#EmphasisDivider",
    "./examples.tsx#VerticalDivider",
    "./examples.tsx#InverseDivider",
    "./examples.tsx#BetweenSectionsExample",
    "./examples.tsx#InlineInfoRowExample"
  ]
}
