{
  "$schema": "../../schema/component.json",
  "name": "DropdownMenu",
  "category": "layout",
  "status": "experimental",
  "version": "0.1.0",
  "description": "A button-triggered action menu with grouped commands, shortcuts, checkboxes, radio choices and nested menus.",
  "figma": {
    "nodeId": null,
    "componentKey": null
  },
  "exports": [
    "DropdownMenu",
    "DropdownMenuProps",
    "DropdownMenuTrigger",
    "DropdownMenuPortal",
    "DropdownMenuGroup",
    "DropdownMenuRadioGroup",
    "DropdownMenuSub",
    "DropdownMenuContentProps",
    "DropdownMenuContent",
    "DropdownMenuSubContent",
    "DropdownMenuLabel",
    "DropdownMenuItem",
    "DropdownMenuSubTrigger",
    "DropdownMenuCheckboxItem",
    "DropdownMenuRadioItem",
    "DropdownMenuSeparator",
    "DropdownMenuShortcut"
  ],
  "props": {
    "open": {
      "type": "boolean",
      "required": false
    },
    "defaultOpen": {
      "type": "boolean",
      "required": false
    },
    "onOpenChange": {
      "type": "function",
      "required": false
    },
    "modal": {
      "type": "boolean",
      "required": false
    }
  },
  "rules": {
    "tokens": {
      "ruleId": "token-exists"
    }
  },
  "tokens": [
    "--space-050",
    "--stroke-default",
    "--border-default",
    "--radius-surface-default",
    "--surface-primary",
    "--elevation-400-menu-panel",
    "--text-primary",
    "--font-weight-normal",
    "--font-size-body-md",
    "--line-height-body-md",
    "--font-family-ios",
    "--space-100",
    "--space-400",
    "--radius-component-default",
    "--surface-secondary",
    "--stroke-thick",
    "--focus-ring",
    "--text-error",
    "--fill-error-secondary",
    "--text-disabled",
    "--text-secondary",
    "--font-size-caption-sm",
    "--line-height-caption-sm",
    "--font-weight-emphasize",
    "--space-200",
    "--divider-default"
  ],
  "tokenBindings": {
    "--space-050": {
      "property": "padding",
      "selector": ".popup"
    },
    "--stroke-default": {
      "property": "border",
      "selector": ".popup"
    },
    "--border-default": {
      "property": "border",
      "selector": ".popup"
    },
    "--radius-surface-default": {
      "property": "border-radius",
      "selector": ".popup"
    },
    "--surface-primary": {
      "property": "background",
      "selector": ".popup"
    },
    "--elevation-400-menu-panel": {
      "property": "box-shadow",
      "selector": ".popup"
    },
    "--text-primary": {
      "property": "color",
      "selector": ".popup"
    },
    "--font-weight-normal": {
      "property": "font",
      "selector": ".popup"
    },
    "--font-size-body-md": {
      "property": "font",
      "selector": ".popup"
    },
    "--line-height-body-md": {
      "property": "font",
      "selector": ".popup"
    },
    "--font-family-ios": {
      "property": "font",
      "selector": ".popup"
    },
    "--space-100": {
      "property": "gap",
      "selector": ".item"
    },
    "--space-400": {
      "property": "min-height",
      "selector": ".item"
    },
    "--radius-component-default": {
      "property": "border-radius",
      "selector": ".item"
    },
    "--surface-secondary": {
      "property": "background",
      "selector": ".item[data-highlighted]:not([data-disabled])"
    },
    "--stroke-thick": {
      "property": "outline",
      "selector": ".item:focus-visible"
    },
    "--focus-ring": {
      "property": "outline",
      "selector": ".item:focus-visible"
    },
    "--text-error": {
      "property": "color",
      "selector": ".item[data-variant=\"destructive\"]"
    },
    "--fill-error-secondary": {
      "property": "background",
      "selector": ".item[data-variant=\"destructive\"][data-highlighted]:not([data-disabled])"
    },
    "--text-disabled": {
      "property": "color",
      "selector": ".item[data-disabled]"
    },
    "--text-secondary": {
      "property": "color",
      "selector": ".label"
    },
    "--font-size-caption-sm": {
      "property": "font-size",
      "selector": ".label"
    },
    "--font-weight-emphasize": {
      "property": "font-weight",
      "selector": ".label"
    },
    "--space-200": {
      "property": "width",
      "selector": ".item > svg"
    },
    "--divider-default": {
      "property": "background",
      "selector": ".separator"
    },
    "--line-height-caption-sm": {
      "property": "line-height",
      "selector": ".label"
    }
  },
  "accessibility": {
    "role": "menu",
    "notes": "Base UI provides typeahead, arrow keys, nested menus, selection semantics, dismissal and focus return."
  },
  "testing": {
    "interaction": "covered",
    "rationale": "Showcase verifies keyboard opening, checkbox and radio selection and focus return from nested menus."
  },
  "dependencies": {
    "runtime": [
      "react",
      "@base-ui/react"
    ],
    "peer": [],
    "devOnly": [
      "@storybook/react-vite",
      "storybook"
    ]
  },
  "usageRef": "./usage.md",
  "examples": [
    "./examples.tsx#ShoppingListMenu"
  ]
}
