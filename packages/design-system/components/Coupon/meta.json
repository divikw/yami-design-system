{
  "$schema": "../../schema/component.json",
  "name": "Coupon",
  "category": "composite",
  "status": "experimental",
  "version": "0.2.0",
  "description": "Controlled coupon card with a claim button or a selection checkbox, scope and optional validity. The host manages claiming and checkout selection.",
  "figma": {
    "nodeId": null,
    "componentKey": null,
    "notes": "Based on the live cart observed on 2026-10-16; no independent Figma binding."
  },
  "exports": [
    "Coupon",
    "CouponProps"
  ],
  "composes": [
    "Checkbox",
    "Button"
  ],
  "props": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string",
      "required": true
    },
    "validity": {
      "type": "string",
      "required": false
    },
    "selected": {
      "type": "boolean",
      "required": false
    },
    "disabled": {
      "type": "boolean",
      "required": false
    },
    "onSelectedChange": {
      "type": "(selected: boolean) => void",
      "required": false
    },
    "className": {
      "type": "string",
      "required": false
    },
    "claim": {
      "type": "{ status: \"available\" | \"claiming\" | \"claimed\"; label: string; onClaim: () => void; useLink?: { href: string; label: string; target?: string } }",
      "required": false
    }
  },
  "rules": {
    "focus": {
      "ruleId": "focus-style",
      "note": "Selection uses whole-label Checkbox activation. Claiming uses a focusable Button."
    },
    "disabled": {
      "ruleId": "no-opacity-disabled",
      "note": "Uses semantic disabled surfaces and text without opacity."
    },
    "depth": {
      "ruleId": "elevation-on-press",
      "note": "Hover uses surface color only."
    }
  },
  "tokens": [
    "--background-secondary",
    "--border-default",
    "--font-family-ios",
    "--font-size-body-md",
    "--font-size-heading-sm",
    "--font-weight-emphasize",
    "--font-weight-normal",
    "--line-height-body-md",
    "--line-height-heading-sm",
    "--radius-button-primary",
    "--space-050",
    "--space-100",
    "--space-150",
    "--space-200",
    "--space-600",
    "--stroke-default",
    "--surface-primary",
    "--surface-secondary",
    "--text-disabled",
    "--text-primary",
    "--text-secondary"
  ],
  "tokenBindings": {
    "--surface-primary": {
      "property": "background",
      "selector": ".segment"
    },
    "--border-default": {
      "property": "border-color",
      "selector": ".segment, .segment::before, .segment::after"
    },
    "--text-primary": {
      "property": "color",
      "selector": ".coupon"
    },
    "--text-secondary": {
      "property": "color",
      "selector": ".details, .coupon:not([data-disabled]) .claimStatus"
    },
    "--text-disabled": {
      "property": "color",
      "selector": ".coupon[data-disabled] .segment"
    },
    "--radius-button-primary": {
      "property": "border-radius",
      "selector": ".selector::before, .segment::before, .segment::after"
    }
  },
  "accessibility": {
    "wcagLevel": "AA",
    "tapTargetMin": 44,
    "keyboardNav": [
      "tab",
      "shift+tab",
      "space",
      "enter"
    ],
    "ariaPattern": "Selection uses a labeled Checkbox. The claim Button describes the coupon title and terms. Pending claims block activation. Claim updates are announced politely. Claimed coupons show localized status text with a decorative checkmark or a native link to use the offer."
  },
  "dependencies": {
    "runtime": [
      "react"
    ],
    "peer": [],
    "devOnly": []
  },
  "usageRef": "./usage.md",
  "examples": [
    "./examples.tsx#CouponExample"
  ],
  "testing": {
    "interaction": "covered",
    "rationale": "Storybook verifies selection by label, checkbox and keyboard, plus claim activation and pending/completed semantics. Cart tests cover saving and cancellation."
  }
}
