{
  "$schema": "../../schema/component.json",
  "name": "SocialMediaGallery",
  "category": "composite",
  "status": "stable",
  "version": "0.1.0",
  "description": "响应式社交视频列表，支持纯文案、单商品和多商品底部样式；PC 列数随实际容器宽度调整。",
  "figma": {
    "fileKey": "6oOAy72DBff4P6NzJYc2hi",
    "nodeId": "6993:63493",
    "notes": "PC gallery 6993:63493, PC child card 6993:63472, and mobile gallery 6962:102989."
  },
  "exports": [
    "SocialMediaGallery",
    "SocialVideoCard",
    "SocialMediaGalleryProps",
    "SocialVideoCardProps",
    "SocialVideoProduct"
  ],
  "composes": [
    "Button"
  ],
  "props": {
    "videoSrc": {
      "type": "string",
      "required": false,
      "description": "可选的静音循环自动播放视频，保留卡片媒体布局。"
    },
    "headingAlign": {
      "type": "\"start\" | \"center\"",
      "required": false,
      "default": "start",
      "description": "标题与辅助说明的对齐方式，移动端卡片固定左对齐。"
    },
    "description": {
      "type": "ReactNode",
      "required": false,
      "description": "标题旁的可选辅助说明。"
    },
    "title": {
      "type": "ReactNode",
      "required": true,
      "description": "PC 模块标题，同时作为无障碍标签。"
    },
    "mobileTitle": {
      "type": "ReactNode",
      "required": false,
      "description": "移动端专用标题，未设置时使用 title。"
    },
    "cards": {
      "type": "SocialVideoCardProps[]",
      "required": true,
      "description": "按顺序展示的视频卡片，需提供稳定 ID。"
    },
    "viewAllHref": {
      "type": "string",
      "required": false,
      "description": "查看全部的可选跳转地址。"
    },
    "viewAllLabel": {
      "type": "ReactNode",
      "required": false,
      "default": "See all",
      "description": "查看全部的本地化文案。"
    },
    "previousLabel": {
      "type": "string",
      "required": false,
      "default": "Previous social videos",
      "description": "上一页按钮的本地化标签。"
    },
    "nextLabel": {
      "type": "string",
      "required": false,
      "default": "Next social videos",
      "description": "下一页按钮的本地化标签。"
    },
    "products": {
      "type": "SocialVideoProduct[]",
      "required": false,
      "description": "卡片底部的可选商品数据，未提供商品时两端均显示纯文案。"
    },
    "dividerPosition": {
      "type": "\"top\" | \"bottom\" | \"none\"",
      "default": "top",
      "required": false,
      "description": "PC 分割线位置，移动端卡片不显示分割线。"
    },
    "dividerVariant": {
      "type": "\"gray\" | \"black\"",
      "default": "gray",
      "required": false,
      "description": "gray 为 1px 灰线，black 为 2px 强调分割线。"
    }
  },
  "rules": {
    "tapTarget": {
      "ruleId": "tap-target",
      "note": "Video and product links remain independent; desktop paging composes shared Button controls."
    },
    "focus": {
      "ruleId": "focus-style",
      "note": "Video, product, view-all, and paging actions use token-backed focus indicators."
    },
    "radius": {
      "ruleId": "no-custom-radii",
      "note": "Gallery, video cards, product images, and account marks consume semantic radius tokens."
    },
    "motion": {
      "ruleId": "elevation-on-press",
      "note": "Native rail paging respects prefers-reduced-motion."
    }
  },
  "tokens": [
    "--surface-primary",
    "--surface-secondary",
    "--text-primary",
    "--text-secondary",
    "--text-primary-inverse",
    "--color-white-1000",
    "--divider-default",
    "--border-focus",
    "--border-focus-inverse",
    "--stroke-default",
    "--stroke-thick",
    "--radius-full",
    "--radius-surface-default",
    "--radius-component-default",
    "--radius-tag-primary",
    "--font-family-ios",
    "--font-weight-normal",
    "--font-weight-emphasize",
    "--font-size-heading-xl",
    "--font-size-display-sm",
    "--font-size-body-md",
    "--font-size-link-sm",
    "--line-height-heading-xl",
    "--line-height-display-sm",
    "--line-height-body-md",
    "--line-height-link-sm",
    "--space-025",
    "--space-050",
    "--space-100",
    "--space-150",
    "--space-200",
    "--space-300",
    "--space-400",
    "--space-500",
    "--space-600"
  ],
  "tokenBindings": {
    "--surface-primary": {
      "property": "background-color",
      "selector": ".root, .moreProducts"
    },
    "--surface-secondary": {
      "property": "background-color",
      "selector": ".card"
    },
    "--divider-default": {
      "property": "border-color",
      "selector": ".root at or above 1024px"
    },
    "--radius-component-default": {
      "property": "border-radius",
      "selector": ".card"
    }
  },
  "accessibility": {
    "wcagLevel": "AA",
    "tapTargetMin": 44,
    "keyboardNav": [
      "tab",
      "shift+tab",
      "enter"
    ],
    "ariaPattern": "labelled section containing a horizontal list of article cards and optional links and paging buttons",
    "structure": "The visible heading labels the section. Each video is an article; video and product destinations remain separate links.",
    "interaction": "Mobile uses native horizontal scrolling. Desktop exposes overflow-aware previous and next controls."
  },
  "dependencies": {
    "runtime": [
      "react",
      "./Button"
    ],
    "peer": [],
    "devOnly": [
      "@figma/code-connect",
      "@storybook/react-vite"
    ]
  },
  "usageRef": "./usage.md",
  "examples": [
    "./examples.tsx#SocialMediaGalleryExample"
  ]
}
