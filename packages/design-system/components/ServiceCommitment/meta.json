{
  "$schema": "../../schema/component.json",
  "name": "ServiceCommitment",
  "category": "composite",
  "status": "experimental",
  "version": "0.1.0",
  "description": "Localized service commitments strip with an optional mobile carousel.",
  "figma": {
    "fileKey": "MHQHWiNXDr06jybKwJNVvs",
    "nodeId": "1181:159271",
    "componentKey": "17de6ea715438313cac63eca8fe94e7db162b00e",
    "notes": "Position=Bottom, Style=2 - Gray supplies the filled icons."
  },
  "exports": ["ServiceCommitment", "ServiceCommitmentProps"],
  "composes": ["Divider"],
  "props": {
    "locale": {
      "type": "\"zh\" | \"en\"",
      "required": false,
      "default": "zh",
      "description": "Language for the built-in service commitments."
    },
    "mobileCarousel": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Cycle through centered rows of benefits that fit the available mobile width."
    },
    "className": {
      "type": "string",
      "required": false,
      "description": "Optional class for page layout."
    }
  },
  "rules": {
    "color": { "ruleId": "semantic-color-only" },
    "numerals": { "ruleId": "numerals-font" }
  },
  "tokens": [
    "--background-primary",
    "--divider-default",
    "--text-primary",
    "--font-family-ios",
    "--font-size-body-md",
    "--font-weight-emphasize",
    "--line-height-heading-md",
    "--layout-page-margin-default",
    "--space-050",
    "--space-100",
    "--space-200",
    "--space-250",
    "--space-400",
    "--space-500",
    "--space-1000",
    "--stroke-default"
  ],
  "tokenBindings": {
    "--background-primary": { "property": "background", "selector": ".root" },
    "--text-primary": { "property": "color", "selector": ".root" },
    "--space-050": { "property": "column-gap", "selector": ".benefit below 1024px" },
    "--space-100": { "property": "column-gap", "selector": ".benefit from 1024px" },
    "--space-200": { "property": "column-gap", "selector": ".list below 928px" },
    "--space-1000": { "property": "min-block-size", "selector": ".container" },
    "--space-250": { "property": "block-size", "selector": ".icon" }
  },
  "accessibility": {
    "structure": "Named list with decorative icons and dividers.",
    "tapTargetMin": 0,
    "keyboardNav": ["Tab", "ArrowUp", "ArrowDown"]
  },
  "dependencies": {
    "runtime": ["react", "./Divider"],
    "peer": [],
    "devOnly": []
  },
  "usageRef": "./usage.md",
  "examples": ["./examples.tsx#ServiceCommitmentExample"],
  "testing": {
    "interaction": "covered",
    "rationale": "Browser tests cover mobile rotation, keyboard focus and the desktop layout."
  }
}
