{
  "name": "@yami/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./components/index.ts",
    "./components": "./components/index.ts",
    "./components/*": "./components/*/index.ts",
    "./components/*/fixtures": "./components/*/fixtures.ts",
    "./styles/base.css": "./styles/base.css",
    "./styles/fonts.css": "./styles/fonts.css",
    "./tokens.css": "./generated/tokens.css",
    "./meta": "./design-system.meta.json",
    "./manifest": "./manifest.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.12.0",
    "storybook": "10.5.10",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
